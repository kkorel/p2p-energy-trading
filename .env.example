# Database
DATABASE_URL=postgresql://p2p_user:p2p_password@localhost:5432/p2p_trading

# Redis
REDIS_URL=redis://localhost:6379

# Service ports
BAP_PORT=4000

# Service URLs
BAP_URL=http://localhost:4000
BPP_URL=http://localhost:4000

# BAP identity
BAP_ID=bap.p2p-trading.local
BAP_URI=http://localhost:4000

# BPP identity
BPP_ID=bpp.p2p-trading.local
BPP_URI=http://localhost:4000

# Callback delay (ms) - simulates async processing
CALLBACK_DELAY=100

# Matching algorithm configuration
MATCH_WEIGHT_PRICE=0.40
MATCH_WEIGHT_TRUST=0.35
MATCH_WEIGHT_TIME=0.25
MIN_TRUST_THRESHOLD=0.2
DEFAULT_TRUST_SCORE=0.5

# Session (IMPORTANT: Change this in production!)
SESSION_SECRET=your-secure-random-secret-key-here
SESSION_EXPIRY_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# External Services
# External CDS (Catalog Discovery Service) - for publishing/discovering offers on Beckn network
# The platform always uses external CDS for full Beckn network participation (no toggle)
EXTERNAL_CDS_URL=https://34.93.141.21.sslip.io/beckn

# DEG Ledger for immutable trade records
LEDGER_URL=https://34.93.166.38.sslip.io
ENABLE_LEDGER_WRITES=false

# Verifiable Credentials (VC) Configuration
VC_PORTAL_URL=https://open-vcs.up.railway.app
# Comma-separated list of trusted issuer DIDs (leave empty to allow all)
VC_TRUSTED_ISSUERS=
# Require cryptographic proof verification (set to 'true' in production)
VC_REQUIRE_PROOF=false
# API key for VC Portal (if required by the portal)
VC_PORTAL_API_KEY=

# ==================== BECKN SECURITY ====================
# Beckn Protocol cryptographic signing configuration
# See: https://developers.becknprotocol.io/docs/infrastructure-layer-specification/authentication

# Enable cryptographic signing of outgoing Beckn messages (XEd25519)
# Set to 'true' in production for secure P2P communication
BECKN_SIGNING_ENABLED=false

# Enable signature verification of incoming Beckn messages
# Set to 'true' in production to reject unsigned/invalid requests
BECKN_VERIFY_SIGNATURES=false

# Subscriber ID for key identification (format: {domain}.{entity}.{network})
BECKN_SUBSCRIBER_ID=p2p-energy-trading.local

# Signature time-to-live in seconds (default: 30)
BECKN_SIGNATURE_TTL=30

# ==================== CORS & RATE LIMITING ====================
# Comma-separated list of allowed CORS origins (* for all)
CORS_ORIGINS=*

# Order cancellation window in minutes
CANCEL_WINDOW_MINUTES=30

# Seller cancellation penalty (financial)
SELLER_CANCEL_PENALTY_RATE=0.05

# Trust penalty for seller cancellation (stricter)
TRUST_SELLER_CANCEL_PENALTY=0.05

# ==================== OORJA CHAT AGENT ====================
# OpenRouter API for LLM-powered chat (intent detection + response composition)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Telegram Bot (optional — disabled if not set)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp Bot via Baileys (optional — disabled if not set to true)
# Requires a spare phone with WhatsApp to scan QR code for linking
WHATSAPP_ENABLED=false
# Number linked to the bot, international format without '+' (used for wa.me deep links)
WHATSAPP_BOT_NUMBER=

# Public URL of the web app, used in links the chat agent sends (defaults to http://localhost:3000/)
APP_URL=

# Sarvam AI for Indian language translation (optional — English-only if not set)
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ==================== GOOGLE SOLAR API ====================
# Google Solar API for installation analysis during onboarding
# Sets initial trading limits (7-15%) based on satellite solar potential data
# Get API key at: https://developers.google.com/maps/documentation/solar
GOOGLE_SOLAR_API_KEY=
# Google Maps API for geocoding addresses and satellite imagery
# Get API key at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ==================== DISCOM MOCK ====================
# DISCOM verification settings for trust score updates
DISCOM_SUCCESS_RATE=0.9
DISCOM_CHECK_INTERVAL_MS=30000
DISCOM_RATE_PER_KWH=10
